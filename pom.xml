<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>custominventoryplugin</artifactId>
    <version>1.29.5</version>
    <packaging>jar</packaging>
    <name>CustomInventoryPlugin</name>
    <description>Bespoke Gear Menu + cross-server backpacks (LuckPerms-gated, MariaDB-backed).</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>codemc-public</id>
            <url>https://repo.codemc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API (matches our 1.21.4 API target; 1.21.11 is binary-compatible) -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.4-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- ProtocolLib (optional; only for the vanilla item-collect fly animation) - local JAR -->
        <dependency>
            <groupId>com.comphenix.protocol</groupId>
            <artifactId>ProtocolLib</artifactId>
            <version>5.4.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/protocollib.jar</systemPath>
        </dependency>

        <!-- LuckPerms API (cross-server permission grants) -->
        <dependency>
            <groupId>net.luckperms</groupId>
            <artifactId>api</artifactId>
            <version>5.4</version>
            <scope>provided</scope>
        </dependency>

        <!-- PlaceholderAPI (provides the customip_ backpack placeholders) -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>

        <!-- Fabled API (skill access + Fabled.getData) - local JAR -->
        <dependency>
            <groupId>studio.magemonkey</groupId>
            <artifactId>fabled</artifactId>
            <version>1.0.4</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/fabled.jar</systemPath>
        </dependency>

        <!-- Divinity API (DivinityDamageEvent, for basic-attack crit) - local JAR -->
        <dependency>
            <groupId>studio.magemonkey</groupId>
            <artifactId>divinity</artifactId>
            <version>1.0.2</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/divinity.jar</systemPath>
        </dependency>

        <!-- CodexCore - Divinity's event superclass (ICancellableEvent) - local JAR -->
        <dependency>
            <groupId>studio.magemonkey</groupId>
            <artifactId>codex</artifactId>
            <version>1.2.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/codex.jar</systemPath>
        </dependency>

        <!-- MythicMobs API (bestiary kill tracking) - local JAR -->
        <dependency>
            <groupId>io.lumine</groupId>
            <artifactId>mythicmobs</artifactId>
            <version>5.12.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/mythicmobs.jar</systemPath>
        </dependency>

        <!-- AlessioDP Parties (party roster / loot / GUI) - local JAR -->
        <dependency>
            <groupId>com.alessiodp.parties</groupId>
            <artifactId>parties</artifactId>
            <version>3.2.18</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/parties.jar</systemPath>
        </dependency>

        <!-- Nexo (NexoPostPackGenerateEvent + the team.unnamed.creative pack model
             it shades, unrelocated) - local JAR.
             repo.nexomc.com only publishes some releases and 1.23.3 is not one of
             them, and the whole point of this dependency is the shaded creative
             API, whose surface moves between Nexo builds. So compile against the
             exact jar the backends run. -->
        <dependency>
            <groupId>com.nexomc</groupId>
            <artifactId>nexo</artifactId>
            <version>1.23.3</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/nexo.jar</systemPath>
        </dependency>

        <!-- HikariCP — connection pooling for MariaDB -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
        </dependency>

        <!-- SLF4J API (HikariCP requires it; provided by Paper at runtime) -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.9</version>
            <scope>provided</scope>
        </dependency>

        <!-- MariaDB JDBC driver — shaded (Paper doesn't ship it for plugins) -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>3.3.3</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- Shade HikariCP + MariaDB JDBC into the JAR, relocated to avoid conflicts -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <minimizeJar>false</minimizeJar>
                            <relocations>
                                <relocation>
                                    <pattern>com.zaxxer.hikari</pattern>
                                    <shadedPattern>com.example.custominventoryplugin.shaded.hikari</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.mariadb</pattern>
                                    <shadedPattern>com.example.custominventoryplugin.shaded.mariadb</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
